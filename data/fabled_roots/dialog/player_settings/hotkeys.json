{
  "type": "minecraft:confirmation",
  "inputs": [
    {
      "type": "minecraft:single_option",
      "key": "ability",
      "label": {
        "translate": "option.fabled_roots.player_settings.ability_hotkey"
      },
      "options": [
        {
          "id": "1",
          "display": {
            "translate": "option.fabled_roots.ability.crouch"
          },
          "initial": true
        },
        {
          "id": "2",
          "display": {
            "translate": "option.fabled_roots.ability.jump"
          }
        },
        {
          "id": "3",
          "display": {
            "translate": "option.fabled_roots.ability.sprint"
          }
        },
        {
          "id": "4",
          "display": {
            "translate": "option.fabled_roots.ability.disabled"
          }
        }
      ]
    }
  ],
  "can_close_with_escape": true,
  "external_title": {
    "translate": "menu.fabled_roots.title.player_settings.title.prefix.main"
  },
  "title": {
    "translate": "menu.fabled_roots.title.player_settings.title.prefix.main"
  },
  "pause": true,
  "yes": {
    "label": {
      "translate": "menu.fabled_roots.confirm"
    },
    "action": {
      "type": "minecraft:dynamic/run_command",
      "template": "trigger fabled_roots.dialog_trigger.ability set $(ability)"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back"
    },
    "action": {
      "type": "minecraft:show_dialog",
      "dialog": "fabled_roots:player_settings/main"
    }
  }
}